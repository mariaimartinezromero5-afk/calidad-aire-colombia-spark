from pyspark.sql import SparkSession
from pyspark.sql.functions import from_json, col, window, avg, count
from pyspark.sql.functions import max as max_, round as round_, to_timestamp
from pyspark.sql.types import StructType, StructField, StringType, DoubleType

spark = SparkSession.builder.appName("CalidadAireStreaming").getOrCreate()
spark.sparkContext.setLogLevel("WARN")

schema = StructType([
    StructField("autoridad", StringType()),
    StructField("variable", StringType()),
    StructField("concentracion", DoubleType()),
    StructField("timestamp", StringType()),
])

df = (spark.readStream.format("kafka")
      .option("kafka.bootstrap.servers", "localhost:9092")
      .option("subscribe", "calidad_aire")
      .load())

parsed = (df.select(from_json(col("value").cast("string"), schema).alias("d"))
          .select("d.*")
          .withColumn("ts", to_timestamp("timestamp")))

stats = (parsed.withWatermark("ts", "2 minutes")
         .groupBy(window(col("ts"), "1 minute"), "autoridad", "variable")
         .agg(round_(avg("concentracion"), 2).alias("promedio"),
              max_("concentracion").alias("maximo"),
              count("*").alias("eventos")))

query = (stats.writeStream.outputMode("update")
         .format("console")
         .option("truncate", False)
         .start())

query.awaitTermination()
